{
	// Provider to use (openai, anthropic, openrouter)
	"provider": "openai",

	// Model to use for all requests
	// You can override this per-request with the --model flag
	"model": "gpt-4o",

	// Provider configuration
	// Add at least one provider below
	"providers": {
		// OpenAI configuration
		// Get your API key from: https://platform.openai.com/api-keys
		"openai": {
			"api_key": "sk-your-openai-api-key",
			"base_url": "https://api.openai.com/v1"
		},

		// Anthropic configuration
		// Get your API key from: https://console.anthropic.com/settings/keys
		"anthropic": {
			"api_key": "sk-ant-your-anthropic-api-key",
			"base_url": "https://api.anthropic.com"
		},

		/*
		 * OpenRouter configuration
		 * Provides access to many models through a single API
		 * Get your API key from: https://openrouter.ai/keys
		 */
		"openrouter": {
			"api_key": "sk-or-your-openrouter-api-key",
			"base_url": "https://openrouter.ai/api/v1"
		}
	},

	// Application settings
	"settings": {
		// System prompt to use from ~/.config/fraga/system_prompts/
		// Specify the filename without the .md extension
		// Leave empty or omit to use the built-in default
		"system_prompt": "",

		// Enable markdown rendering in terminal output
		// Omit or set to false to disable
		"render_markdown": true,
	},

	/*
	 * MCP (Model Context Protocol) server configuration
	 * See: https://modelcontextprotocol.io for more information
	 *
	 * MCP servers provide tools that the LLM can use to interact with external systems
	 */
	"mcp": {
		// Filesystem server - allows LLM to read/write files
		// Install: npm install -g @modelcontextprotocol/server-filesystem
		"filesystem": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/allowed"],
			"env": {}
		},

		// Fetch server - allows LLM to make HTTP requests
		// Install: npm install -g @modelcontextprotocol/server-fetch
		"fetch": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-fetch"],
		},

		// GitHub server - allows LLM to interact with GitHub
		// Install: npm install -g @modelcontextprotocol/server-github
		"github": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-github"],
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "your-github-token"
			}
		},

		// Remote SSE server example
		// Connects to a remote MCP server via Server-Sent Events
		"remote": {
			"url": "https://remote-mcp-server.com/sse"
		}
	}
}
